# READING DATA
classified_news <- data.table::fread("C:/Users/mario/OneDrive/ITAM/4to semestre/Inv Aplicada II/Mario - Tesis/code/BETO/data/results_beto/labeled_news130524.csv")
classified_news <- classified_news %>%
dplyr::mutate(
date = as.Date(paste0(year,"-",month,"-",day)),
day_wo_year = format(date, "%d-%m")
) %>%
dplyr::select(KEY, date, year, month, day, day_wo_year, newspaper, predicted_sentiment, predicted_sentiment_str)
# CALENDAR WITH FESTIVITIES
calendario <- data.table::fread("C:/Users/mario/OneDrive/ITAM/4to semestre/Inv Aplicada II/Mario - Tesis/code/BETO/data/results_beto/calendario_treatment.csv")
base_news <-
classified_news %>%
left_join(., calendario, by = c("KEY"="KEY","year"="year","day_wo_year"="day_wo_year"))
### WEIGHTS (-1 ANTI || +1 PRO: SOLO MORENA)
base_news <-
base_news %>%
dplyr::mutate(predicted_sentiment = ifelse(predicted_sentiment == 0, -1, 1))
### TREATMENT: 1 si time_to_event 0:3, 0 e.o.c
base_news <-
base_news %>%
dplyr::mutate(treatment_event = ifelse(time_to_event %in% c(0,1,2,3), 1, 0))
# CONTEO DE NOTICIAS
conteo_news <- base_news %>%
dplyr::group_by(treatment_event, n_week, year, KEY) %>% tally()
# ANALISIS (1: SD)
datos_agrupados <- base_news %>%
dplyr::group_by(treatment_event, n_week, year, KEY) %>%
dplyr::summarise(desv_est_sentimiento = sd(predicted_sentiment, na.rm = TRUE))
datos_agrupados <- left_join(datos_agrupados, conteo_news, by = c("treatment_event", "n_week", "year","KEY"))
# Ejemplo de gráfico de caja con la desviación estándar
ggplot(datos_agrupados, aes(x = factor(treatment_event), y = desv_est_sentimiento)) +
geom_boxplot() +
labs(x = "Tratamiento (en semana 0 a 3)", y = "Desviación Estándar del Sentimiento") +
facet_wrap(~year) + theme_pubclean(base_size = 12)
# Ejemplo de gráfico de caja con la desviación estándar
ggplot(datos_agrupados, aes(x = factor(treatment_event), y = desv_est_sentimiento)) +
geom_boxplot() +
labs(x = "Tratamiento (en semana 0 a 3)", y = "Desviación Estándar del Sentimiento") +
facet_wrap(~year) #+ theme_pubclean(base_size = 12)
t.test(desv_est_sentimiento ~ treatment_event, data = datos_agrupados)
# ANALISIS (2: RDI)
calcular_rdi <- function(x) {
mean(abs(x - mean(x, na.rm = TRUE)), na.rm = TRUE)
}
datos_agrupados <- base_news %>%
dplyr::group_by(treatment_event, n_week, year, KEY) %>%
dplyr::summarise(rdi = calcular_rdi(predicted_sentiment))
datos_agrupados <- left_join(datos_agrupados, conteo_news, by = c("treatment_event", "n_week", "year","KEY"))
ggplot(datos_agrupados, aes(x = factor(treatment_event), y = rdi)) +
geom_boxplot() +
labs(x = "Tratamiento (en semana 0 a 3)", y = "Indice de dispersion") +
facet_wrap(~year) #+ theme_pubclean(base_size = 12)
t.test(rdi ~ treatment_event, data = datos_agrupados)
# NOTICIAS NEGATIVAS
conteo_negativas <-
base_news %>%
dplyr::group_by(treatment_event, n_week, year, KEY, predicted_sentiment_str) %>%
tally() %>% ungroup() %>%
dplyr::filter(n < 30)
conteo_treatment_plot <-
ggplot(conteo_negativas %>% dplyr::filter(treatment_event == 0),
aes(x=n, color = predicted_sentiment_str, fill = predicted_sentiment_str)) +
geom_density(alpha=0.2) + theme_minimal() +
ggtitle("Treatment density") +
xlab("News count")
conteo_control_plot <-
ggplot(conteo_negativas %>% dplyr::filter(treatment_event == 1),
aes(x=n, color = predicted_sentiment_str, fill = predicted_sentiment_str)) +
geom_density(alpha=0.2) + theme_minimal() +
ggtitle("Control density") +
xlab("News count")
library(patchwork)
conteo_treatment_plot+conteo_control_plot
