geom_point(aes(colour = factor(type)), size = 2) +
geom_errorbar(aes(ymin=(coeficientes-1.96*ses), ymax=(coeficientes+1.96*ses), colour = factor(type)), width=0.2) +
geom_hline(yintercept = 0, linetype="solid", color ="grey", 2) +
geom_vline(xintercept = 26,linetype="dashed", color ="red", 2) +
theme_bw() +
labs(subtitle = "Registros al menos 2 ideologias") +
ylab("Valor estimado (95% IC)") +
xlab("Semanas desde tratamiento") +
ylim(-0.35,0.35) +
scale_color_manual(name = "Periodo", values= colors) +
theme(legend.position = "none")
DID_plot2
coefs = c(dd_plot_reg_mas_de_una$coefficients[20:25],
0,
dd_plot_reg_mas_de_una$coefficients[26:33])
se = c(dd_plot_reg_mas_de_una$se[20:25],
0,
dd_plot_reg_mas_de_una$se[26:33])
datos_did <- data.frame(coeficientes = coefs, ses = se, time = -7:7,
type = c(rep(1,7),rep(2,4),rep(1,4)))
datos_did$time <- factor(datos_did$time)
colors <- c("#000000","#D55E00")
DID_plot3 <- ggplot(data = datos_did, mapping = aes(y = coeficientes, x = time)) +
geom_point(aes(colour = factor(type)), size = 2) +
geom_errorbar(aes(ymin=(coeficientes-1.96*ses), ymax=(coeficientes+1.96*ses), colour = factor(type)), width=0.2) +
geom_hline(yintercept = 0, linetype="solid", color ="grey", 2) +
geom_vline(xintercept = 7,linetype="dashed", color ="red", 2) +
theme_bw(base_size = 12) +
#labs(subtitle = "Registros al menos 2 ideologias") +
ylab("Valor estimado (95% IC)") +
xlab("Semanas desde tratamiento") +
ylim(-0.65,0.65) +
scale_color_manual(name = "Periodo", values= colors) +
theme(legend.position = "none")
